{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://excalidraw-desktop.invalid/schemas/performance-report-2.0.0.json",
  "title": "Excalidraw Desktop performance evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "commit",
    "hardware",
    "memory",
    "architecture",
    "logicalCores",
    "osVersion",
    "webviewVersion",
    "executionEnvironment",
    "workload",
    "samples",
    "statistic",
    "budget",
    "verdict"
  ],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hardware": { "type": "string", "minLength": 1 },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "gibibytes"],
      "properties": {
        "bytes": { "type": "integer", "minimum": 1 },
        "gibibytes": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "architecture": { "type": "string", "minLength": 1 },
    "logicalCores": { "type": "integer", "minimum": 1 },
    "osVersion": { "type": "string", "minLength": 1 },
    "webviewVersion": { "type": "string", "minLength": 1 },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Exact executable identity. Required for new baseline/candidate comparisons; optional here to preserve validation of historical v2 reports.",
      "required": ["path", "sha256", "kind", "pathScope"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "The exact executable path used by the runner. Do not use a glob or a symlink alias."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Full lowercase SHA-256 digest of the exact executable bytes."
        },
        "kind": {
          "enum": ["e2e-harness", "production"],
          "description": "Whether the measured executable is a test-only harness or a production build."
        },
        "pathScope": {
          "enum": ["absolute", "workspace-relative"],
          "description": "Whether path is the runner's absolute path or a workspace-relative privacy-normalized path."
        }
      }
    },
    "executionEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "hostHardware", "virtualization"],
      "properties": {
        "type": { "enum": ["physical", "virtual", "unspecified"] },
        "hostHardware": { "type": "string", "minLength": 1 },
        "virtualization": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "version"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              }
            }
          ]
        }
      }
    },
    "workload": { "type": "object" },
    "processTreeAccounting": { "type": "object" },
    "samples": { "type": "object" },
    "statistic": { "type": "object" },
    "budget": { "type": "object" },
    "verdict": {
      "type": "object",
      "required": ["overall", "scope", "reason"],
      "properties": {
        "overall": { "enum": ["pass", "fail", "not_evaluated"] },
        "scope": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
